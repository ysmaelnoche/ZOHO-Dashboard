{
  "name": "tvs-ph-crm-dashboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.20.2"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "npm run build && node scripts/zet.cjs run",
    "validate": "npm run build && node scripts/zet.cjs validate",
    "pack": "npm run build && node scripts/zet.cjs pack",
    "test": "npm run build && node --test tests/dashboard.test.cjs"
  },
  "dependencies": {
    "portfinder": "1.0.38"
  },
  "devDependencies": {
    "playwright-core": "1.58.2",
    "typescript": "5.9.3",
    "zoho-extension-toolkit": "1.0.30"
  }
}
